# OAuth client created on the SparrowDesk instance below (see SETUP.md, step 2)
SPARROWDESK_CLIENT_ID=
SPARROWDESK_CLIENT_SECRET=

# Local SparrowDesk (sd-app-backend docker compose + sd-app-frontend `npm start`)
SPARROWDESK_OAUTH_ISSUER=http://app.sparrowdesk.test
SPARROWDESK_OAUTH_AUTHORIZE_URL=http://app.sparrowdesk.test/login
SPARROWDESK_API_BASE=http://app.sparrowdesk.test/v1
MCP_PUBLIC_URL=http://localhost:3000

# DynamoDB Local from the sd-app-backend docker compose
DYNAMO_REGION=us-east-1
DYNAMO_PREFIX=local_mcp_app_
DYNAMO_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
